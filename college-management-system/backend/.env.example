# -----------------------------------------------------------------------------
# Backend environment configuration (EXAMPLE)
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.
# No real secrets belong in this example file or in any source code.
# -----------------------------------------------------------------------------

# ---- Server ----
PORT=5000
NODE_ENV=development

# CORS: allowed frontend origin(s). Comma-separate multiple origins.
# Inspect how you serve the frontend and set the matching origin(s).
#   - python -m http.server 8000      -> http://localhost:8000
#   - VS Code Live Server             -> http://127.0.0.1:5500
#   - npx serve                       -> http://localhost:3000
FRONTEND_URL=http://localhost:8000,http://127.0.0.1:5500,http://localhost:5500

# ---- PostgreSQL ----
# Preferred: a single connection string (used first if present).
#   Example: postgresql://user:password@localhost:5432/college_cms
DATABASE_URL=

# Fallback: individual connection variables (used when DATABASE_URL is empty).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=college_cms
DB_USER=postgres
DB_PASSWORD=

# Set to true only when connecting to a managed DB that requires SSL.
DB_SSL=false

# ---- Firebase Admin SDK (service account) ----
# These come from a Firebase service-account JSON (Project settings ->
# Service accounts -> Generate new private key). They are SECRETS — keep them
# only in .env, never in source or in the frontend.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full private key in quotes. Keep the literal \n escapes on one line;
# the app converts them back to real newlines at runtime.
#   Example: FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# ---- Firebase Cloud Storage ----
# The Storage bucket for class file attachments (notes/papers/assignments/
# projects/message attachments). Use the *.firebasestorage.app bucket name from
# the Firebase console (Storage). Do NOT use the legacy *.appspot.com form.
#   Example: FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# When empty, file uploads are cleanly disabled (503 STORAGE_NOT_ENABLED) — the
# app never falls back to local disk or fake URLs.
FIREBASE_STORAGE_BUCKET=
